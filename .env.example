# Copy to .env for local development.

# --- Web app (exposed to the browser, must start with VITE_) ---

# Default network for the wallet UI: qday (QDay + USD8) or base (Base + USDC, disabled for now).
VITE_DEFAULT_NETWORK=qday

# QDay network. Only QDay needs env: Base comes built into viem/wagmi (Base Sepolia for now).
# The chain id is a placeholder until the QDay testnet details are confirmed.
VITE_QDAY_CHAIN_ID=0
VITE_QDAY_RPC_URL=
VITE_QDAY_EXPLORER_URL=

# --- Vercel API function (server only, never exposed to the browser) ---
# Comments are stored as GitHub Issues. Without a token they fall back to browser localStorage.

# Fine-grained token with Issues read/write on the repo below.
GITHUB_TOKEN=
# owner/name of the repo that receives comment issues.
GITHUB_REPO=mytoandeptrai/qday-signet-ui-agent-passport
