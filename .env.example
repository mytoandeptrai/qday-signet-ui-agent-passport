# Copy to .env for local development.

# --- Web app (exposed to the browser, must start with VITE_) ---

# Default network for the wallet UI: qday (QDay + USD8) or base (Base + USDC, disabled for now).
VITE_DEFAULT_NETWORK=qday

# QDay network. Only QDay needs env: Base comes built into viem/wagmi (Base Sepolia for now).
# The chain id is a placeholder until the QDay testnet details are confirmed.
VITE_QDAY_CHAIN_ID=0
VITE_QDAY_RPC_URL=
VITE_QDAY_EXPLORER_URL=
# Native gas currency shown when MetaMask adds the QDay network (placeholders: QDay / QDAY / 18).
VITE_QDAY_NATIVE_CURRENCY_NAME=
VITE_QDAY_NATIVE_CURRENCY_SYMBOL=
VITE_QDAY_NATIVE_CURRENCY_DECIMALS=
# USD8 token decimals (placeholder: 8).
VITE_QDAY_USD8_DECIMALS=

# Reown (WalletConnect) project id. RainbowKit requires one even when only MetaMask is enabled.
# Create one at https://cloud.reown.com (placeholder used when empty).
VITE_WALLETCONNECT_PROJECT_ID=

# MoonPay card on-ramp ("Buy with card" on Overview). Hidden until both key and sign URL are set.
# pk_test_ runs the widget in sandbox, pk_live_ in production. The secret key stays on the signing server.
VITE_MOONPAY_PUBLISHABLE_KEY=
# Server holding the secret key: GET /ip-hash -> { allowedIpAddress } and GET /sign-url?url= -> { signature }.
VITE_MOONPAY_SERVER_URL=http://localhost:5050
# Coin to buy. Sandbox has no Base, so eth (Sepolia) for testing; usdc_base in production.
VITE_MOONPAY_CURRENCY_CODE=eth

# --- Vercel API function (server only, never exposed to the browser) ---
# Comments are stored as GitHub Issues. Without a token they fall back to browser localStorage.

# Fine-grained token with Issues read/write on the repo below.
GITHUB_TOKEN=
# owner/name of the repo that receives comment issues.
GITHUB_REPO=mytoandeptrai/qday-signet-ui-agent-passport
